{
  "name": "nahthatsfake-tma",
  "version": "1.0.0",
  "description": "Nah That's Fake - Telegram Mini App",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run build:reporting",
    "build:reporting": "esbuild browser-reporting.js --bundle --minify --format=iife --outfile=public/js/reporting.js --define:__REPORTING_PRODUCTION__=true",
    "test:reporting": "node --test tests/reporting.test.cjs"
  },
  "keywords": [
    "telegram",
    "mini-app",
    "tma",
    "deepfake",
    "scam"
  ],
  "author": "Nah That's Fake Team",
  "license": "MIT",
  "dependencies": {
    "@sentry/browser": "10.78.0",
    "@sentry/node": "10.78.0",
    "@supabase/supabase-js": "^2.38.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "razorpay": "^2.9.6"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  }
}
