{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LabSecuritySchema25",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^sec_25_[a-f0-9]{8}$"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "score"
  ],
  "additionalProperties": false
}