{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConfigSchema12",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "enum": [
        "development",
        "staging",
        "production"
      ]
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "options": {
      "type": "object",
      "properties": {
        "enableCache": {
          "type": "boolean"
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "required": [
    "profile",
    "threshold"
  ]
}