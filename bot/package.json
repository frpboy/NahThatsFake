{
  "name": "nahthatsfake-bot",
  "version": "1.0.0",
  "description": "Nah That's Fake - Telegram Bot for Deepfake & Scam Detection",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test:markdown": "ts-node --project tsconfig.test.json tests/markdown.test.ts",
    "test:urlscanner": "ts-node --project tsconfig.test.json tests/urlscanner.test.ts",
    "test:sightengine": "ts-node --project tsconfig.test.json tests/sightengine.test.ts",
    "test:separate-results": "ts-node --project tsconfig.test.json tests/separate-results.test.ts",
    "test:payment-shutdown": "ts-node --project tsconfig.test.json tests/payment-shutdown.test.ts"
  },
  "keywords": [
    "telegram",
    "bot",
    "deepfake",
    "scam",
    "detection"
  ],
  "author": "Nah That's Fake Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "@types/node-cron": "^3.0.11",
    "axios": "^1.13.5",
    "dotenv": "^17.3.1",
    "grammy": "^1.40.0",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
